---
import { getRelativeLocaleUrl } from "astro:i18n";
import Player from "./art/Player.astro";
import { defaultLocale, locales, text } from "../i18n";

const locale = Astro.currentLocale ?? defaultLocale;
const t = text(locale);
const languages = locales.map((code) => ({ code, href: getRelativeLocaleUrl(code), current: code === locale }));
---

<header class="site-header">
  <div class="container bar">
    <a href={getRelativeLocaleUrl(locale)} class="logo">
      <svg viewBox="-10 -10 20 20" width="34" height="34" aria-hidden="true"><Player label="KH" /></svg>
      <span>{t.site}</span>
    </a>
    <nav aria-label={t.languages}>
      <ul>
        {
          languages.map((l) => (
            <li>
              <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? "page" : undefined}>
                {l.code.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-navy);
    border-bottom: 1px solid var(--color-navy-line);
  }

  /* 16 + 44 + 16, plus the 1 px border: 77 px. The logo (34 px) is lower than the link.
     At 320 px: 34 + 8 + 134.4 + 12 + 94 = 282.4 of the 288 px. */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 16px;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-on-navy);
  }

  /* The text stays kayhardam.dev; on screen in capitals. The KH player before it
     is decoration. Until Barlow loads, the text is wider (188 px): then only the
     text shrinks and is cut off, without a horizontal scroll. */
  .logo {
    gap: 8px;
    min-width: 0;
    font-size: 20px;
    text-transform: uppercase;
  }

  @media (min-width: 560px) {
    .logo {
      gap: 10px;
    }
  }

  .logo svg {
    flex: none;
    pointer-events: none;
  }

  .logo span {
    overflow: hidden;
    white-space: nowrap;
  }

  nav {
    flex: none;
  }

  ul {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
  }

  nav a {
    justify-content: center;
    min-width: var(--tap);
    padding: 0 12px;
    border: 1px solid var(--color-navy-line);
    border-radius: var(--radius-sm);
    font-size: 16px;
  }
  nav a:hover {
    border-color: var(--color-on-navy-small);
  }
  /* Green on dark (#15803D, white on it 5.0:1); #16A34A would be 3.3:1. */
  nav a[aria-current="page"] {
    background: var(--color-green-dark);
    border-color: var(--color-green-dark);
  }
</style>
