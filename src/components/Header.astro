---
import { getRelativeLocaleUrl } from "astro:i18n";
import Player from "./art/Player.astro";
import { defaultLocale, locales, text } from "../i18n";

const locale = Astro.currentLocale ?? defaultLocale;
const t = text(locale);
const languages = locales.map((code) => ({ code, href: getRelativeLocaleUrl(code), current: code === locale }));
---

<header class="site-header">
  <div class="container bar">
    <a href={getRelativeLocaleUrl(locale)} class="logo">
      {/* The KH player with the ball, as in the mockup (phase 10): the ball has the
          page's colour, so it cuts into the player's edge. The viewBox is the
          two together: x −9.5 to 14.45, y −12.45 to 9.5. */}
      <svg viewBox="-9.5 -12.5 24 22" width="37" height="34" aria-hidden="true">
        <Player label="KH" fill="#1E40AF" ink="#FFFFFF" />
        <circle cx="10.2" cy="-8.2" r="3.4" fill="#FDFBF8" stroke="#1E40AF" stroke-width="1.7"></circle>
      </svg>
      <span>{t.site}</span>
    </a>
    <nav aria-label={t.languages}>
      <ul>
        {
          languages.map((l) => (
            <li>
              <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? "page" : undefined}>
                {l.code.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
  }

  /* 16 + 44 + 16: 76 px. At 320 px: 37 + 8 + 124.6 (16 px) + 12 + 94 (2 × 44 + 6)
     = 275.6 of the 288 px. */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 16px;
  }

  /* Flex, not inline-flex: no line box, so nothing moves when the font comes. */
  a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
    font-weight: 800;
    color: var(--color-text);
  }

  /* The text stays kayhardam.dev, in lower case as written. 16 px at 320 px,
     20 px from 400 px. Until the font loads, the text may be wider: then only
     the text shrinks and is cut off, without a horizontal scroll. */
  .logo {
    gap: 8px;
    min-width: 0;
    font-size: clamp(16px, 5vw, 20px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* The label KH would inherit the link's letter-spacing, scaled with the logo:
     0, as in public/favicon.svg. e2e/art.spec.ts checks every label. */
  .logo svg {
    flex: none;
    letter-spacing: 0;
    pointer-events: none;
  }

  .logo span {
    overflow: hidden;
    white-space: nowrap;
  }

  nav {
    flex: none;
  }

  ul {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
  }

  /* Always 44 px wide, in any font. The current language on a card's colour,
     with its edge; the other grey, and on the card's colour under the pointer. */
  nav a {
    justify-content: center;
    width: var(--tap);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    color: var(--color-text-small);
  }
  nav a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  nav a[aria-current="page"] {
    border-color: var(--color-line);
    background: var(--color-surface);
    color: var(--color-text);
  }
</style>
