---
// The header of Hars (15 November 2026): sticky, on espresso. "Kay Hardam" on the
// left, a link to the home page; on the right the language switch (from 560 px;
// below it the page's foot has it) and the button "Plan een gesprek", amber with
// espresso text, which opens an email to Kay.
import { getRelativeLocaleUrl } from "astro:i18n";
import Languages from "./Languages.astro";
import { mailto } from "../data/links";
import { defaultLocale, text } from "../i18n";

const locale = Astro.currentLocale ?? defaultLocale;
const t = text(locale);
---

<header class="site-header">
  <div class="container bar">
    <a href={getRelativeLocaleUrl(locale)} class="name">{t.name}</a>
    <div class="end">
      <Languages class="header-languages" />
      <a class="talk" href={mailto}>{t.talk}</a>
    </div>
  </div>
</header>
<style>
  /* Sticky on espresso, 64 px high: 10 + 44 + 10. A line in room below it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--espresso);
    border-bottom: 1px solid color-mix(in srgb, var(--room) 12%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
  }

  a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
  }

  /* The name: Barlow Condensed 800 in capitals, room (17.5:1). Until the font
     loads, the name may be wider: it is cut off, the page doesn't scroll. */
  .name {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(18px, 5.6vw, 22px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--room);
  }

  .end {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }

  /* The language switch: zand, the current one room; only from 560 px. */
  .end :global(.header-languages) {
    display: none;
    color: var(--zand);
  }

  @media (min-width: 560px) {
    .end :global(.header-languages) {
      display: block;
    }
  }

  .end :global(.header-languages a[aria-current="page"]) {
    color: var(--room);
  }

  /* The button: amber with espresso text (10.5:1), Barlow Condensed 700 in capitals.
     A fixed width, so nothing in the header moves when the font comes (in the fallback
     font the text is wider, and cut off until then): 168 px in Barlow Condensed for
     "Plan een gesprek", 122 px for "Book a call" (e2e/narrow.spec.ts checks it fits). */
  .talk {
    justify-content: center;
    width: 9.5em;
    overflow: hidden;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--amber);
    color: var(--espresso);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 5vw, 18px); /* 16 px at 320 px: the name and the button fit beside each other */
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .talk:hover {
    background: var(--room);
  }

  :global(html[lang="en"]) .talk {
    width: 7em;
  }
</style>
