---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/kay-hardam.jpg";
import Header from "./Header.astro";
import Board from "./board/Board.astro";
import FieldLines from "./art/FieldLines.astro";
import Pass from "./art/Pass.astro";
import SectionNumber from "./art/SectionNumber.astro";
import { boards } from "../data/boards";
import { coachboard, email, github, mailto } from "../data/links";
import { defaultLocale, text, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = text(locale);
const [lead, rest] = t.statement;
const [atName, atDomain] = email.split("@");
const [beforeGithub, githubLink, afterGithub] = t.contact.github;
---

<BaseLayout title={t.title} description={t.description}>
  <Header />
  <main>
    <section class="hero">
      <FieldLines variant="hero" />
      <div class="container hero-grid">
        <div class="hero-text">
          <h1>{t.name}</h1>
          <p class="statement"><span class="lead">{lead}</span> {rest}</p>
        </div>
        <div class="hero-board">
          <Board link={boards[locale]} t={t.board} />
          <a class="hero-button" href={boards[locale]}>{t.hero.button}</a>
        </div>
      </div>
    </section>

    <section class="coachboard">
      <div class="container coachboard-grid">
        <div class="coachboard-head">
          <Pass />
          <SectionNumber n={1} variant="navy" ring />
          <h2>{t.coachboard.heading}</h2>
        </div>
        <div class="coachboard-text">
          <p class="intro">{t.coachboard.text[0]}</p>
          <p class="note">{t.coachboard.text[1]}</p>
          <a class="outline-button" href={coachboard[locale]}>
            {t.coachboard.button}
            <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M2 8h11M9 3.5 13.5 8 9 12.5" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="about">
      <FieldLines variant="about" />
      <div class="container about-grid">
        <Picture
          src={portrait}
          alt={t.about.photo}
          formats={["avif", "webp"]}
          widths={[300, 600, 900]}
          sizes="min(300px, 70vw)"
          width={300}
          height={300}
          loading="lazy"
          decoding="async"
          class="photo"
        />
        <div class="about-text">
          <SectionNumber n={2} variant="white" />
          <h2 class="small-heading">{t.about.heading}</h2>
          {t.about.text.map((sentence) => <p class="big">{sentence}</p>)}
          <p class="example">{t.about.example}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="contact">
    <div class="container">
      <SectionNumber n={3} variant="white" />
      <h2 class="small-heading">{t.contact.heading}</h2>
      <p class="question">{t.contact.question}</p>
      <p class="mail">{t.contact.mail}</p>
      {/* On one line; the <wbr> only as a fallback on very narrow screens. */}
      <p><a class="email" href={mailto}>{atName}@<wbr />{atDomain}</a></p>
      <p class="github">{beforeGithub}<a href={github}>{githubLink}</a>{afterGithub}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /*
   * Phone and tablet: one column, the board first. Only in CSS: the HTML keeps
   * the text first, and the text has no links, so the tab order stays logical.
   * From 860 px: text left, board right, centred; the board sets the row's height.
   * The space below makes room for the pass to section 1 (Pass.astro): it starts
   * 32 px below the statement on the phone, 64 px above the hero's edge from 860 px.
   */
  .hero {
    position: relative;
    padding-block: 16px 80px;
  }

  /* Above the field lines (FieldLines.astro), which are absolute too. */
  .hero > .container,
  .about > .container {
    position: relative;
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
  }

  .hero-board {
    order: -1;
  }

  .hero-text {
    margin-top: 32px;
  }

  @media (min-width: 560px) {
    .hero-board {
      max-width: 560px;
    }
  }

  @media (min-width: 860px) {
    /* 32 px above, as in the mockup: the button stays on a laptop screen of 800 px. */
    .hero {
      padding-block: 32px 112px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: center;
    }

    .hero-board {
      order: 0;
    }

    .hero-text {
      margin-top: 0;
    }
  }

  /* The name: small and white. */
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-navy);
  }

  .statement {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 4.6vw, 64px);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-on-navy);
  }
  /* The first sentence on a line of its own. */
  .lead {
    display: block;
    color: var(--color-on-navy-muted);
  }

  /* Always 56 px: one line, or two balanced lines on narrow phones. */
  .hero-button {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin-top: 16px;
    padding: 0 16px;
    border-radius: var(--radius-sm);
    background: var(--color-on-navy);
    color: var(--color-navy);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    text-decoration: none;
  }

  /* The three sections: 64 px on the phone, as in the mockup from 860 px. */
  .coachboard,
  .about,
  .contact {
    padding-block: 64px;
  }

  @media (min-width: 860px) {
    .coachboard,
    .about,
    .contact {
      padding-block: 104px 112px;
    }
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Grey on both dark sections: 5.7:1 on #1E293B, 7.0:1 on navy. */
  .small-heading {
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--color-on-navy-small);
  }

  /* Coachboard: on white, like Coachboard itself. */
  .coachboard {
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* The pass hangs here, above number 1. */
  .coachboard-head {
    position: relative;
  }

  .coachboard h2 {
    font-size: clamp(56px, 8vw, 112px);
    line-height: 0.85;
  }

  .coachboard-text {
    margin-top: 32px;
  }

  @media (min-width: 860px) {
    .coachboard-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
    }

    .coachboard-text {
      margin-top: 0;
    }
  }

  .intro {
    font-size: 19px;
  }

  .note {
    margin-top: 16px;
    color: var(--color-text-muted);
  }

  .outline-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin-top: 32px;
    padding: 0 24px;
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-sm);
    color: var(--color-navy);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .outline-button:hover {
    background: var(--color-navy);
    color: #fff;
  }

  .arrow {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* About me: on the second navy, white text (14.0:1). */
  .about {
    position: relative;
    background: var(--color-navy-soft);
    color: var(--color-on-navy);
  }

  /* One column on the phone and tablet: the photo above the text, at most 760 px wide. */
  .about-text {
    max-width: 760px;
  }

  /* Round, like a player in Coachboard: a white edge, like the logo and the numbers.
     aspect-ratio keeps the square while it loads, and in WebKit also when it fails. */
  .photo {
    width: min(300px, 70vw);
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 40px;
    border: 5px solid #fff;
    border-radius: 50%;
  }

  /* From 860 px: the photo left, the text right, centred on each other. */
  @media (min-width: 860px) {
    .about-grid {
      display: grid;
      grid-template-columns: 300px minmax(0, 760px);
      gap: 64px;
      align-items: center;
    }

    .photo {
      width: 300px;
      margin-bottom: 0;
    }
  }

  .big {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.05;
  }

  .example {
    max-width: 620px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 19px;
  }

  /* Contact: the footer, on navy. */
  .contact {
    border-top: 1px solid var(--color-navy-line);
  }

  .question {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1;
    text-transform: uppercase;
  }

  .mail {
    margin-top: 32px;
    font-size: 19px;
    color: var(--color-on-navy-muted);
  }

  /* 8.15em wide: 277 px at 34 px, so one line from 320 px. The padding makes it 44 px high. */
  .email {
    display: inline-block;
    padding-block: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 7vw, 96px);
    line-height: 1.1;
    color: var(--color-on-navy);
    text-decoration: underline 4px var(--color-text-small);
    text-underline-offset: 0.12em;
  }

  .github {
    margin-top: 32px;
    color: var(--color-on-navy-muted);
  }

  /* 17 × 1.6 = 27.2 px of text, plus the padding: 45 px. */
  .github a {
    display: inline-block;
    padding-block: 9px;
    color: var(--color-on-navy);
  }
</style>
