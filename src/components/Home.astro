---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import editorNl from "../assets/coachboard-editor-nl.png";
import editorEn from "../assets/coachboard-editor-en.png";
import Header from "./Header.astro";
import Languages from "./Languages.astro";
import Board from "./board/Board.astro";
import Figures from "./Figures.svelte";
import Lens from "./Lens.svelte";
import taps from "../data/tap-targets.json";
import { boards } from "../data/boards";
import { coachboard, email, evidence, mailto } from "../data/links";
import { defaultLocale, text, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = text(locale);
const [atName, atDomain] = email.split("@");

// The figures, each with its evidence.
const figures = t.figures.map((figure, i) => ({ ...figure, href: evidence[i]! }));

// The lens: the editor's screenshot in this language, as AVIF and WebP at 1× and 2× of
// its 393 px (the frame shows it at most 320 px wide), and the targets measured on it.
const editor = locale === "nl" ? editorNl : editorEn;
const shot = async (format: "avif" | "webp") => getImage({ src: editor, format, width: 393, densities: [1, 2] });
const [avif, webp] = await Promise.all([shot("avif"), shot("webp")]);
const lensImage = { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, sizes: "320px" };
// A piece's area as one string, as SVG's points, in whole pixels: Astro writes a prop's
// every number with a type of its own, so the arrays were most of the page's HTML. To
// draw it a pixel is enough; its measures (size, width, height) keep their decimal.
const lensTargets = taps[locale].targets.map(({ points, ...target }) =>
  points ? { ...target, points: points.map((p) => p.map(Math.round).join(",")).join(" ") } : target,
);

// The work: each project with its address (Movva and Coachboard Lite come later, Kay).
const sites: Record<string, string> = { Coachboard: coachboard[locale] };
---

<BaseLayout title={t.title} description={t.description}>
  <Header />
  <main>
    {/* The hero (Hars, 15 November 2026): the board tells the story. The name is the page's
        heading, for screen readers; on screen the header shows it. */}
    <section class="hero">
      <div class="container">
        <h1 class="visually-hidden">{t.name}</h1>
        <Board link={boards[locale]} edit={t.hero.button} t={t.board} />
      </div>
    </section>

    {/* Three figures, each a link to its evidence in Coachboard. */}
    <section class="figures-section">
      <div class="container">
        <Figures client:visible={{ rootMargin: "200px" }} items={figures} />
      </div>
    </section>

    {/* The lens over Coachboard's editor, with the touch targets measured on it. */}
    <section class="lens-section">
      <div class="container">
        <h2 class="section-heading">{t.lens.heading}</h2>
        <Lens client:visible targets={lensTargets} image={lensImage} locale={locale} t={t.lens} />
      </div>
    </section>

    {/* The work: each project, how far it is, and the technique behind it. */}
    <section class="work-section">
      <div class="container">
        <h2 class="section-heading">{t.work.heading}</h2>
        <ul class="work">
          {
            t.work.items.map((item) => (
              <li>
                <h3>
                  <a href={sites[item.name]}>{item.name}</a>
                </h3>
                <p class="status">{item.status}</p>
                <p class="tech">{item.tech}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* The close, on amber: one goal, a conversation. The address on one line; the <wbr>
        only as a fallback on very narrow screens. Below 560 px the language switch is
        here: the header has no room for it beside its button. */}
    <section class="close">
      <div class="container">
        <h2 class="close-heading">{t.close.heading}</h2>
        <p><a class="email" href={mailto}>{atName}@<wbr />{atDomain}</a></p>
        <Languages class="close-languages" />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* The hero on the stage: walnoot-donker, the court and the text in board.css. */
  .hero {
    padding-block: 24px 40px;
    background: var(--walnoot-donker);
  }

  @media (min-width: 860px) {
    .hero {
      padding-block: 56px;
    }
  }

  /* The figures, the lens and the work on the ground: espresso, room text. */
  .figures-section,
  .lens-section,
  .work-section {
    padding-block: 56px;
  }

  @media (min-width: 860px) {
    .figures-section,
    .lens-section,
    .work-section {
      padding-block: 88px;
    }

    .lens-section,
    .work-section {
      padding-top: 0;
    }
  }

  /* The figures: three in a row from 860 px, one under the other below it. Each a link:
     the figure in amber, Barlow Condensed 800 (10.5:1 on espresso), on a line of its own,
     so its width while counting moves nothing; the sentence in room, underlined in amber;
     what it was in zand (11:1). */
  .figures-section :global(.figures) {
    display: grid;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 860px) {
    .figures-section :global(.figures) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
    }
  }

  .figures-section :global(.figures a) {
    display: block;
    font-size: var(--text);
    line-height: 1.5;
    color: var(--room);
    text-decoration: none;
  }

  .figures-section :global(.figure-value) {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 9vw, 112px);
    line-height: 1;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }

  .figures-section :global(.figure-rest) {
    font-weight: 600;
    text-decoration: underline 2px var(--amber);
    text-underline-offset: 5px;
  }

  .figures-section :global(.figures a:hover .figure-rest) {
    color: var(--amber);
  }

  .figures-section :global(.figure-was) {
    color: var(--zand);
  }

  /* The headings of the lens and the work: Barlow Condensed 800 in capitals. */
  .section-heading {
    margin-bottom: 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    text-transform: uppercase;
  }

  /* The work: a line per project, between lines in room. The name in Barlow Condensed
     800, a link; the status a label in amber with its word (never colour alone); the
     technique in JetBrains Mono, zand (11:1). */
  .work {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--room) 16%, transparent);
  }

  .work li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 24px;
    padding-block: 20px;
    border-bottom: 1px solid color-mix(in srgb, var(--room) 16%, transparent);
  }

  .work h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1;
    text-transform: uppercase;
  }

  .work h3 a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--room);
    text-decoration: underline 3px var(--amber);
    text-underline-offset: 6px;
  }
  .work h3 a:hover {
    color: var(--amber);
  }

  .status {
    padding: 4px 10px;
    border: 2px solid var(--amber);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--amber);
  }

  .tech {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--zand);
  }

  /* From 860 px on one row: the name, the technique, the status. */
  @media (min-width: 860px) {
    .work li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    }

    .tech {
      grid-row: 1;
      grid-column: 2;
    }

    .status {
      grid-row: 1;
      grid-column: 3;
    }
  }

  /* The close: amber, with espresso text (10.5:1). */
  .close {
    padding-block: 64px 40px;
    background: var(--amber);
    color: var(--espresso);
  }

  @media (min-width: 860px) {
    .close {
      padding-block: 112px 64px;
    }
  }

  .close-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 10vw, 136px);
    line-height: 0.95;
    text-transform: uppercase;
  }

  /* The address, large: Barlow Condensed 700, on one line from 320 px (19 characters
     at 30 px: about 250 px of the 288). The padding makes it 44 px high and more. */
  .email {
    display: inline-block;
    margin-top: 24px;
    padding-block: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 8vw, 88px);
    line-height: 1.1;
    color: var(--espresso);
    text-decoration: underline 4px var(--espresso);
    text-underline-offset: 0.14em;
  }
  .email:hover {
    text-decoration-thickness: 7px;
  }

  /* Below 560 px the language switch, in espresso; from 560 px it is in the header. */
  .close :global(.close-languages) {
    margin-top: 40px;
  }

  @media (min-width: 560px) {
    .close :global(.close-languages) {
      display: none;
    }
  }
</style>
