---
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/kay-hardam.jpg";
import editorNl from "../assets/coachboard-editor-nl.png";
import editorEn from "../assets/coachboard-editor-en.png";
import Header from "./Header.astro";
import Board from "./board/Board.astro";
import Figures from "./Figures.svelte";
import Lens from "./Lens.svelte";
import taps from "../data/tap-targets.json";
import SectionNumber from "./art/SectionNumber.astro";
import { boards } from "../data/boards";
import { coachboard, drills, email, evidence, github, mailto, tactics } from "../data/links";
import { defaultLocale, text, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = text(locale);
const [atName, atDomain] = email.split("@");
const [beforeGithub, githubLink, afterGithub] = t.footer.github;
const [beforeTactics, tacticsLink, betweenLinks, drillsLink, afterDrills] = t.coachboard.note;
const [beforeProduct, productLink, afterProduct] = t.about.product;

// The figures, each with its evidence.
const figures = t.figures.map((figure, i) => ({ ...figure, href: evidence[i]! }));

// The lens: the editor's screenshot in this language, as AVIF and WebP at 1× and 2× of
// its 393 px (the frame shows it at most 320 px wide), and the targets measured on it.
const editor = locale === "nl" ? editorNl : editorEn;
const shot = async (format: "avif" | "webp") => getImage({ src: editor, format, width: 393, densities: [1, 2] });
const [avif, webp] = await Promise.all([shot("avif"), shot("webp")]);
const lensImage = { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, sizes: "320px" };
// A piece's area as one string, as SVG's points, in whole pixels: Astro writes a prop's
// every number with a type of its own, so the arrays were most of the page's HTML. To
// draw it a pixel is enough; its measures (size, width, height) keep their decimal.
const lensTargets = taps[locale].targets.map(({ points, ...target }) =>
  points ? { ...target, points: points.map((p) => p.map(Math.round).join(",")).join(" ") } : target,
);
---

<BaseLayout title={t.title} description={t.description}>
  <Header />
  <main>
    {/* The hero (Hars, 15 November 2026): the board tells the story. The name is the page's
        heading, for screen readers; on screen the header shows it (the header of Hars, step 6). */}
    <section class="hero">
      <div class="container">
        <h1 class="visually-hidden">{t.name}</h1>
        <Board link={boards[locale]} edit={t.hero.button} t={t.board} />
      </div>
    </section>

    {/* Three figures, each a link to its evidence in Coachboard (Hars, 15 November 2026). */}
    <section class="figures-section">
      <div class="container">
        <Figures client:visible={{ rootMargin: "200px" }} items={figures} />
      </div>
    </section>

    {/* The lens over Coachboard's editor, with the touch targets measured on it. */}
    <section class="lens-section">
      <div class="container">
        <h2 class="lens-heading">{t.lens.heading}</h2>
        <Lens client:visible targets={lensTargets} image={lensImage} locale={locale} t={t.lens} />
      </div>
    </section>

    <section class="coachboard">
      <div class="container">
        <div class="card coachboard-grid">
          <div class="coachboard-head">
            <SectionNumber n={1} />
            <h2>{t.coachboard.heading}</h2>
          </div>
          <div class="coachboard-text">
            <p class="intro">{t.coachboard.intro}</p>
            <p class="note">{beforeTactics}<a href={tactics[locale]}>{tacticsLink}</a>{betweenLinks}<a href={drills[locale]}>{drillsLink}</a>{afterDrills}</p>
            <a class="outline-button" href={coachboard[locale]}>
              {t.coachboard.button}
              <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M2 8h11M9 3.5 13.5 8 9 12.5" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="about">
      <div class="container">
        <div class="card about-grid">
          <Picture
            src={portrait}
            alt={t.about.photo}
            formats={["avif", "webp"]}
            widths={[300, 600, 900]}
            sizes="min(300px, 70vw)"
            width={300}
            height={300}
            loading="lazy"
            decoding="async"
            class="photo"
          />
          <div class="about-text">
            <SectionNumber n={2} />
            <h2 class="eyebrow">{t.about.heading}</h2>
            {t.about.text.map((sentence) => <p class="big">{sentence}</p>)}
            <p class="product">{beforeProduct}<a href={coachboard[locale]}>{productLink}</a>{afterProduct}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="contact">
      <div class="container">
        <div class="card">
          <SectionNumber n={3} />
          <h2 class="eyebrow">{t.contact.heading}</h2>
          <p class="question">{t.contact.question}</p>
          <p class="mail">{t.contact.mail}</p>
          {/* On one line; the <wbr> only as a fallback on very narrow screens. */}
          <p><a class="email" href={mailto}>{atName}@<wbr />{atDomain}</a></p>
        </div>
      </div>
    </section>
  </main>

  {/* The footer (phase 11): one small line, with the link to GitHub; LinkedIn comes later. */}
  <footer class="site-footer">
    <div class="container">
      <p class="footer-line">{t.footer.line}</p>
      <p class="footer-links">{beforeGithub}<a href={github} rel="me">{githubLink}</a>{afterGithub}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* The hero on the stage: walnoot-donker, the court and the text in board.css. */
  .hero {
    padding-block: 24px 40px;
    background: var(--walnoot-donker);
  }

  @media (min-width: 860px) {
    .hero {
      padding-block: 56px;
    }
  }

  /* The figures and the lens on the ground of Hars: espresso, room text. The old
     sections below them keep their 56 or 88 px apart, until they are rebuilt. */
  .figures-section,
  .lens-section {
    padding-block: 56px;
    background: var(--espresso);
    color: var(--room);
  }

  .lens-section {
    margin-bottom: 56px;
  }

  @media (min-width: 860px) {
    .figures-section {
      padding-block: 88px 56px;
    }

    .lens-section {
      padding-block: 56px 88px;
      margin-bottom: 88px;
    }
  }

  /* The figures: three in a row from 860 px, one under the other below it. Each a link:
     the figure in amber, Barlow Condensed 800 (10.5:1 on espresso), on a line of its own,
     so its width while counting moves nothing; the sentence in room, underlined in amber;
     what it was in zand (11:1). */
  .figures-section :global(.figures) {
    display: grid;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 860px) {
    .figures-section :global(.figures) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
    }
  }

  .figures-section :global(.figures a) {
    display: block;
    font-size: var(--text);
    line-height: 1.5;
    color: var(--room);
    text-decoration: none;
  }

  .figures-section :global(.figure-value) {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 9vw, 112px);
    line-height: 1;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }

  .figures-section :global(.figure-rest) {
    font-weight: 600;
    text-decoration: underline 2px var(--amber);
    text-underline-offset: 5px;
  }

  .figures-section :global(.figures a:hover .figure-rest) {
    color: var(--amber);
  }

  .figures-section :global(.figure-was) {
    color: var(--zand);
  }

  /* The lens's heading: Barlow Condensed 800 in capitals. */
  .lens-heading {
    margin-bottom: 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    text-transform: uppercase;
  }

  /* The three sections: a card each, 56 px apart on the phone, 88 px from 860 px. */
  .coachboard,
  .about,
  .contact {
    padding-bottom: 56px;
  }

  @media (min-width: 860px) {
    .coachboard,
    .about,
    .contact {
      padding-bottom: 88px;
    }
  }

  /* 20 px inside on the phone: then the email address fits on one line at 320 px. */
  .card {
    padding: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }

  @media (min-width: 560px) {
    .card {
      padding: 40px;
    }
  }

  @media (min-width: 860px) {
    .card {
      padding: 56px;
    }
  }

  /* The headings of About me and Contact, small above the big text: the mockup's
     eyebrow, ink blue on the card (7.8:1). */
  .eyebrow {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* The links in running text: dark and bold, underlined in ink blue. 17 × 1.6 =
     27.2 px of text, plus the padding: 45 px (48.4 px at 19 px). The negative
     margin keeps the line as high as the others; only the touch target grows. */
  .note a,
  .product a {
    display: inline-block;
    padding-block: 9px;
    margin-block: -9px;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: underline 2px var(--color-accent);
    text-underline-offset: 4px;
  }
  .note a:hover,
  .product a:hover {
    color: var(--color-accent);
  }

  /* Coachboard: the heading left, the text right from 860 px. "Coachboard" is one
     word and must fit its column: 235 px at 40 px, 376 px at 64 px. */
  .coachboard h2 {
    font-weight: 800;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .coachboard-text {
    margin-top: 24px;
  }

  @media (min-width: 860px) {
    .coachboard-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 64px;
    }

    .coachboard-text {
      margin-top: 0;
    }
  }

  .intro {
    font-size: 19px;
    line-height: 1.55;
  }

  .note {
    margin-top: 16px;
    color: var(--color-text-muted);
  }

  /* The mockup's second button: the page's colour on the card, an edge of 2 px,
     ink blue under the pointer. */
  .outline-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin-top: 32px;
    padding: 0 24px;
    border: 2px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.2;
    text-decoration: none;
  }
  .outline-button:hover {
    border-color: var(--color-accent);
  }

  .arrow {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* About me. One column on the phone and tablet: the photo above the text, at most 760 px wide. */
  .about-text {
    max-width: 760px;
  }

  /* Round, like a player in ink blue: an edge of 4 px, as in the mockup.
     aspect-ratio keeps the square while it loads, and in WebKit also when it fails. */
  .photo {
    width: min(300px, 70vw);
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 40px;
    border: 4px solid var(--color-accent);
    border-radius: 50%;
  }

  /* From 860 px: the photo left, the text right, centred on each other. */
  @media (min-width: 860px) {
    .about-grid {
      display: grid;
      grid-template-columns: 300px minmax(0, 760px);
      gap: 64px;
      align-items: center;
    }

    .photo {
      width: 300px;
      margin-bottom: 0;
    }
  }

  .big {
    margin-top: 16px;
    font-weight: 800;
    font-size: clamp(26px, 2.8vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  /* Under the big sentence, after a line: what Kay makes, with the link. */
  .product {
    max-width: 620px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
    font-size: 19px;
  }

  /* Contact: the last card. */
  .question {
    margin-top: 16px;
    font-weight: 800;
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .mail {
    margin-top: 24px;
    font-size: 19px;
    color: var(--color-text-muted);
  }

  /* On one line from 320 px: 239 px at 22 px, and the card has 246 there. The
     padding makes it 44 px high at 22 px. */
  .email {
    display: inline-block;
    padding-block: 10px;
    font-weight: 800;
    font-size: clamp(22px, 6.8vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: underline 3px var(--color-accent);
    text-underline-offset: 0.18em;
  }
  .email:hover {
    color: var(--color-accent);
  }

  /* The footer: small and grey, after a line, below the last card's 56 or 88 px.
     The link is 44 px high (15 × 1.6 = 24 px of text, plus the padding) without
     a negative margin: the paragraph has only this line. */
  .site-footer {
    padding-block: 24px 40px;
    border-top: 1px solid var(--color-line);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-small);
  }

  .site-footer .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 24px;
  }

  .footer-line,
  .footer-links {
    margin: 0;
  }

  .footer-links a {
    display: inline-block;
    padding-block: 10px;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: underline 2px var(--color-accent);
    text-underline-offset: 4px;
  }
  .footer-links a:hover {
    color: var(--color-accent);
  }
</style>
