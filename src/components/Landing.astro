---
// The landing page (Kay, 25 November 2026): "van zaal naar bord". Kay's statement over a sports
// hall where the attack "Kruising MO–LO" is played as the reader scrolls, step by step with its
// sentences; then the hall becomes the Coachboard drawing of that attack. Below it his sentence
// about Coachboard, the links to the attack and to Coachboard's board, and the address.
//
// Everything is here without JavaScript: the statement, the four steps as a list, the board at
// the end (Court.svelte, rendered at build time, in Coachboard's own colours) and the links. The
// one island, Opening.svelte, adds the hall: a 3D scene in a canvas (src/lib/opening/scene.ts).
// Where the browser has scroll-driven animations and the reader hasn't asked for less motion,
// this page's CSS makes the opening a tall section with a sticky stage, and shows the
// statement, each step and the board along the scroll, without the island; the scene draws the
// same moments, from the same scroll. Elsewhere (and without JavaScript) the opening is a plain
// page: the statement, the steps and the board. The step windows are scene.ts's (PH).
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Court from "./board/Court.svelte";
import Opening from "./opening/Opening.svelte";
import { boardFrom } from "../data/boards";
import { coachboardBoard, email, mailto } from "../data/links";
import { drawing, tacticPages, tactics } from "../data/opening";
import { defaultLocale, text, type Locale } from "../i18n";
import type { Labels } from "../lib/opening/scene";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = text(locale);
const tactic = await boardFrom(tactics[locale]);
const page = tacticPages[locale];
// The lineup's seven labels (six attackers and the keeper), for the scene's discs and shirts.
const labels = (tactic.frames[0]?.players ?? []).slice(0, 7).map((p) => p.label ?? "");
if (labels.length !== 7 || labels.some((label) => !label)) throw new Error(`The attack has no seven labels: ${tactic.title}`);
const steps = tactic.frames.map((frame, i) => {
  if (!frame.text) throw new Error(`Step ${i + 1} of ${tactic.title} has no sentence`);
  return { counter: t.board.counter.replace("{n}", String(i + 1)).replace("{count}", String(tactic.frames.length)), text: frame.text };
});
---

<BaseLayout title={t.title} description={t.description}>
  <Header talk={false} />
  <main>
    {/* The opening. The copy comes first, so it is read first: the name (the page's heading),
        the statement and the steps; then the stage with the hall and the board. */}
    <section class="opening" data-opening>
      <div class="sticky">
        <div class="copy">
          <h1 class="visually-hidden">{t.name}</h1>
          <p class="statement">{t.holding.statement.map((lines) => <span class="sentence">{lines.map((line, i) => <>{i > 0 && " "}<span class="line">{line}</span></>)}</span>)}</p>
          <ol class="steps" aria-label={tactic.title}>
            {
              steps.map((step, i) => (
                <li class:list={["step", `step-${i + 1}`]}>
                  <span class="counter" aria-hidden="true">{step.counter} · {tactic.title}</span>
                  <span class="text">{step.text}</span>
                </li>
              ))
            }
          </ol>
          <div class="hint" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"></path></svg>
          </div>
        </div>
        <div class="stage">
          <Opening client:visible labels={labels as unknown as Labels} home={t.opening.home} away={t.opening.away} />
          <div class="board" data-opening-board>
            <Court board={drawing(tactic)} label={`${t.board.court}: ${tactic.title}`} viewBox="-8 -14 216 174" />
          </div>
        </div>
      </div>
    </section>

    <section class="end">
      <div class="container">
        <p class="product">{t.holding.product}</p>
        <div class="links">
          {page ? <a class="tactic" href={page}>{tactic.title}</a> : <p class="tactic">{tactic.title}</p>}
          <a class="edit" href={tactics[locale]}>{t.hero.button}</a>
          <a class="draw" href={coachboardBoard[locale]}>{t.opening.button}</a>
        </div>
      </div>
    </section>

    <section class="close">
      <div class="container">
        <p><a class="email" href={mailto}>{email}</a></p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ---------- The plain opening: without JavaScript, with less motion, or in a browser without
     scroll-driven animations. The statement, the steps as a list and the board; from 860 px
     the board beside them. ---------- */
  .sticky {
    display: grid;
    gap: 28px;
    max-width: var(--container);
    margin-inline: auto;
    padding: 32px var(--gutter) 40px;
  }

  @media (min-width: 860px) {
    .sticky {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
      align-items: start;
      gap: 48px;
      padding-block: 56px;
    }
  }

  .copy {
    display: grid;
    align-content: start;
    gap: 28px;
  }

  /* Kay's statement, as on the holding page: Barlow Condensed 800 in capitals, the first
     sentence in marine (17.1:1 on krijt), the second in oranje-donker (4.9:1). Each line on
     its own, in a box of 8.8em, so its size is the same before and after the font loads. */
  .statement {
    width: 8.8em;
    max-width: 100%;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: min(10.2vw, 42px);
    line-height: 1;
    text-transform: uppercase;
  }

  @media (min-width: 860px) {
    .statement {
      font-size: clamp(48px, 5.4vw, 72px);
    }
  }

  .sentence {
    display: block;
  }

  .sentence:last-child {
    color: var(--oranje-donker);
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  /* The steps: the counter with the attack's title in JetBrains Mono, oranje-donker, then the
     sentence in Barlow 600. */
  .steps {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 4px;
  }

  .counter {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--oranje-donker);
  }

  .text {
    font-weight: 600;
    font-size: 17px;
    line-height: 1.35;
  }

  .hint {
    display: none;
  }

  .stage {
    position: relative;
  }

  /* The board: Court.svelte at the viewBox -8 -14 216 174, in Coachboard's own colours; the
     players' labels in Barlow Condensed 700, as on the scene's discs. */
  .board {
    width: 100%;
    aspect-ratio: 216 / 174;
  }

  .board :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .board :global([data-kind="player"] text) {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* The canvas: only in the moving opening (below). */
  .stage :global(.scene) {
    display: none;
  }

  /* ---------- The moving opening: where the browser has scroll-driven animations and the
     reader hasn't asked for less motion. The section is tall; its stage sticks under the
     header while the reader scrolls through it, and the scroll is the timeline: --opening,
     from the section's top at the header (0%) to its bottom at the window's (100%). Each part
     shows in its window of that timeline, the steps in the scene's (scene.ts, PH). ---------- */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
      .opening {
        height: 520svh;
        view-timeline: --opening block;
        view-timeline-inset: var(--header) 0px;
      }

      .sticky {
        position: sticky;
        top: var(--header);
        height: calc(100svh - var(--header));
        max-width: none;
        padding: 0;
        gap: 0;
        grid-template-areas: "all";
        overflow: hidden;
      }

      .copy,
      .stage {
        grid-area: all;
      }

      .stage {
        overflow: hidden;
      }

      /* The hall fades in once the scene has drawn its first moment (Opening.svelte). */
      .stage :global(.scene) {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.6s;
      }

      .opening[data-opening="3d"] .stage :global(.scene) {
        opacity: 1;
      }

      /* What shows along the scroll: each part its keyframes, in its window of --opening. In
         longhands, never the shorthand animation: the build's CSS minifier would put the
         timeline in the shorthand, which browsers don't read there. */
      .board,
      .statement,
      .steps .step,
      .hint {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --opening;
      }

      /* The board: across the stage, in its middle; it fades in over the scene's last moments. */
      .board {
        position: absolute;
        left: 0;
        top: 50%;
        translate: 0 -50%;
        animation-name: opening-in;
        animation-range: contain 90% contain 97%;
      }

      /* The copy lies over the stage; it has nothing to click. */
      .copy {
        position: relative;
        z-index: 1;
        display: block;
        pointer-events: none;
      }

      .statement {
        position: absolute;
        top: 28px;
        left: var(--gutter);
        animation-name: opening-out;
        animation-range: contain 6% contain 12%;
      }

      /* One step at a time, on a card at the stage's foot. */
      .steps .step {
        position: absolute;
        right: 16px;
        bottom: 24px;
        left: 16px;
        padding: 12px 14px;
        border: 1px solid color-mix(in srgb, var(--marine) 12%, transparent);
        border-radius: 12px;
        background: color-mix(in srgb, var(--krijt) 96%, transparent);
        animation-name: opening-step;
      }

      .steps .step-1 {
        animation-range: contain 8% contain 30%;
      }

      .steps .step-2 {
        animation-range: contain 30% contain 45%;
      }

      .steps .step-3 {
        animation-range: contain 45% contain 52%;
      }

      .steps .step-4 {
        animation-range: contain 52% contain 74%;
      }

      /* A hint to scroll, while the reader hasn't yet. */
      .hint {
        position: absolute;
        bottom: 30px;
        left: 50%;
        display: grid;
        place-items: center;
        width: var(--tap);
        height: var(--tap);
        translate: -50% 0;
        border-radius: 50%;
        background: color-mix(in srgb, var(--krijt) 90%, transparent);
        color: var(--marine);
        animation-name: opening-out;
        animation-range: contain 0% contain 3%;
      }

      .hint svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* From 860 px: the copy on the left, the stage on the right as a tall window. The
         statement stays, the steps are a list in which the current one stands out. */
      @media (min-width: 860px) {
        .sticky {
          grid-template-areas: none;
          grid-template-columns: minmax(0, 1fr) min(460px, 40vw);
          align-items: stretch;
          gap: 48px;
          max-width: var(--container);
          padding: 24px var(--gutter);
        }

        .copy,
        .stage {
          grid-area: auto;
        }

        .copy {
          display: grid;
          align-content: center;
          gap: 32px;
        }

        .stage {
          border: 1px solid color-mix(in srgb, var(--marine) 12%, transparent);
          border-radius: 16px;
        }

        .statement {
          position: static;
          animation-name: none;
        }

        /* The current step in marine with an oranje line, the others in leisteen (7.2:1). */
        .steps .step {
          position: static;
          padding: 0 0 0 16px;
          border: 0;
          border-left: 3px solid var(--oranje);
          border-radius: 0;
          background: none;
          animation-name: opening-active;
        }

        .hint {
          display: none;
        }
      }
    }
  }

  @keyframes opening-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes opening-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes opening-step {
    0%,
    100% {
      opacity: 0;
    }
    8%,
    92% {
      opacity: 1;
    }
  }

  @keyframes opening-active {
    0%,
    100% {
      border-left-color: color-mix(in srgb, var(--marine) 12%, transparent);
      color: var(--leisteen);
    }
    8%,
    92% {
      border-left-color: var(--oranje);
      color: var(--marine);
    }
  }

  /* ---------- Below the opening: Kay's sentence about Coachboard and the links. ---------- */
  .end {
    padding-block: 40px 48px;
  }

  @media (min-width: 860px) {
    .end {
      padding-block: 56px 72px;
    }
  }

  .product {
    max-width: 32em;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.4;
  }

  .links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 20px;
  }

  /* The attack's title: a link to its page in Coachboard's library, where there is one. */
  .tactic {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--leisteen);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .edit {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
    font-size: 18px;
    color: var(--marine);
    text-decoration: underline 2px var(--oranje);
    text-underline-offset: 5px;
  }

  .edit:hover,
  .tactic:hover {
    color: var(--oranje-donker);
  }

  /* The button: oranje with marine text (5.0:1), Barlow Condensed 700 in capitals. */
  .draw {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 6px;
    background: var(--oranje);
    color: var(--marine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .draw:hover {
    background: var(--oranje-donker);
    color: var(--krijt);
  }

  /* The foot: marine, with the address in krijt (17.1:1), underlined in oranje. */
  .close {
    padding-block: 32px;
    background: var(--marine);
    color: var(--krijt);
  }

  @media (min-width: 860px) {
    .close {
      padding-block: 56px;
    }
  }

  .email {
    display: inline-block;
    max-width: 100%;
    padding-block: 8px;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 8vw, 88px);
    line-height: 1.1;
    color: var(--krijt);
    text-decoration: underline 4px var(--oranje);
    text-underline-offset: 0.14em;
  }

  .email:hover {
    text-decoration-thickness: 7px;
  }
</style>
