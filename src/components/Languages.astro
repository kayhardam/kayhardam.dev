---
// The language switch, NL and EN: in the header from 560 px, and at the foot of the
// page below it, where the header has no room for it beside the button (Hars).
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLocale, locales, text } from "../i18n";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const languages = locales.map((code) => ({ code, href: getRelativeLocaleUrl(code), current: code === locale }));
---

<nav class:list={["languages", className]} aria-label={text(locale).languages}>
  <ul>
    {
      languages.map((l) => (
        <li>
          <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? "page" : undefined}>
            {l.code.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    list-style: none;
    padding: 0;
  }

  /* Always 44 × 44 px. The current language underlined; the colours come from where it is. */
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    color: inherit;
  }

  a[aria-current="page"] {
    text-decoration: underline 2px currentColor;
    text-underline-offset: 6px;
  }
</style>
