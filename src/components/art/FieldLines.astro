---
// Field lines on the background of the hero and of About me (brief, "Beeldtaal").
// The paths are those of Court.svelte at commit 4ceafd4 (Coachboard), the
// colours and places those of the mockup. Put it as the first child of a
// section with position: relative; the wrapper clips it to the section, so it
// sticks out nowhere and blocks no click.
interface Props {
  variant: "hero" | "about";
}

const { variant } = Astro.props;
const hero = variant === "hero";
---

<div class:list={["field-lines", `on-${variant}`]} aria-hidden="true">
  <svg viewBox="-8 -14 216 120" fill="none" stroke-width="0.8">
    {hero && <rect x="85" y="-10" width="30" height="10" stroke="#1E293B" />}
    <path
      d="M 25 0 A 60 60 0 0 0 85 60 L 115 60 A 60 60 0 0 0 175 0"
      stroke={hero ? "#1E293B" : "#FFFFFF"}
      stroke-opacity={hero ? undefined : "0.2"}></path>
    <path
      d="M -5 0 A 90 90 0 0 0 85 90 L 115 90 A 90 90 0 0 0 205 0"
      stroke={hero ? "#22C55E" : "#FFFFFF"}
      stroke-opacity={hero ? "0.3" : "0.16"}
      stroke-dasharray="4 3"></path>
    {hero && <line x1="95" x2="105" y1="70" y2="70" stroke="#1E293B" />}
  </svg>
</div>

<style>
  .field-lines {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }

  /* base.css gives every svg max-width: 100%; this one is wider than its box. */
  svg {
    position: absolute;
    max-width: none;
    height: auto;
  }

  /* The hero: none on the phone and tablet, where the board is the court. */
  .on-hero {
    display: none;
  }

  /* About me on the phone and tablet: the goal at the top right, as from 860 px,
     with the arcs coming in behind the photo and out at its right (variant B,
     Kay, 18 October 2026; back with the photo in phase 7). Without the photo
     it was 120 px higher (B2, phase 6). */
  .on-about svg {
    width: 640px;
    top: -30px;
    right: -260px;
  }

  /* From 860 px as in the mockup: at 1280 px the goal lies behind the card. */
  @media (min-width: 860px) {
    .on-hero {
      display: block;
    }

    .on-hero svg {
      width: 1040px;
      top: -60px;
      right: -220px;
    }

    .on-about svg {
      width: 960px;
      top: -40px;
      right: -300px;
    }
  }
</style>
