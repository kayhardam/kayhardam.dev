---
import Player from "./Player.astro";

// A section number as a player: 36 px, an edge of 2 px and a digit of 15 px.
// That is a circle of radius 8.5 with an edge of 1, at scale 2: smaller than
// Court.svelte's 9, so the whole player is 36 px. Ink blue with a white digit,
// like the logo (phase 10).
interface Props {
  n: number;
}

const { n } = Astro.props;
---

<svg class="section-number" viewBox="-9 -9 18 18" width="36" height="36" aria-hidden="true">
  <Player label={String(n)} r={8.5} fill="#1E40AF" ink="#FFFFFF" />
</svg>

<style>
  /* 16 px to the heading below it. */
  .section-number {
    display: block;
    margin-bottom: 16px;
    overflow: visible;
    pointer-events: none;
  }
</style>
