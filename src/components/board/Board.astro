---
// The board card in the hero. Decodes the share link at build time and makes
// the legend; a broken link, a link without a title (the label above the court)
// or a legend item without a text stops the build.
// BoardCard.svelte draws the card: an island with client:visible, which gets the
// decoded board as props, so the browser never decodes the link. Its HTML from
// the server is the card without JavaScript: step 1, with the buttons off.
// The styles are in board.css, shared with the island, as BoardViewer.css is in Coachboard.
import "./board.css";
import BoardCard from "./BoardCard.svelte";
import { boardFrom, legendFor } from "../../data/boards";
import { defaultLocale, type Locale } from "../../i18n";
import type { Text } from "../../i18n/nl";

interface Props {
  /** The Coachboard share link, the same as the hero button's. */
  link: string;
  t: Text["board"];
}

const { link, t } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const board = await boardFrom(link);
const legend = legendFor(board, locale);
---

<BoardCard client:visible board={board} legend={legend} t={t} />
