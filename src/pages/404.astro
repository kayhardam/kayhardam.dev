---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { locales, text } from "../i18n";

// One page for every missing URL: Dutch first, then English (Kay, 17 October 2026).
const blocks = locales.map((code) => ({ code, t: text(code).notFound, home: getRelativeLocaleUrl(code) }));
---

<BaseLayout title={text("nl").notFound.title} noindex>
  <main class="container">
    {
      blocks.map(({ code, t, home }) => (
        <section lang={code}>
          <h1>{t.heading}</h1>
          <p>{t.text}</p>
          <a href={home}>{t.home}</a>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  main {
    padding-block: 64px;
  }

  section + section {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid color-mix(in srgb, var(--on-ground) 16%, transparent);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    text-transform: uppercase;
  }

  p {
    margin-top: 12px;
    color: var(--second);
  }

  /* The text's colour and bold, underlined in the accent, as the home page's link. The colours
     are the palette's roles (tokens.css): inkt and ink blue in Inkt, room and amber in Hars. */
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: 8px;
    font-weight: 600;
    color: var(--on-ground);
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 4px;
  }
  a:hover {
    color: var(--accent);
  }
</style>
