---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { locales, text } from "../i18n";

// One page for every missing URL: Dutch first, then English (Kay, 17 October 2026).
const blocks = locales.map((code) => ({ code, t: text(code).notFound, home: getRelativeLocaleUrl(code) }));
---

<BaseLayout title={text("nl").notFound.title} noindex>
  <main class="container">
    {
      blocks.map(({ code, t, home }) => (
        <section lang={code}>
          <h1>{t.heading}</h1>
          <p>{t.text}</p>
          <a href={home}>{t.home}</a>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  main {
    padding-block: 64px;
  }

  section + section {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid var(--color-line);
  }

  h1 {
    font-weight: 800;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  p {
    margin-top: 12px;
    color: var(--color-text-muted);
  }

  /* As the links in running text on the home page: dark and bold, underlined in ink blue. */
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: 8px;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: underline 2px var(--color-accent);
    text-underline-offset: 4px;
  }
  a:hover {
    color: var(--color-accent);
  }
</style>
