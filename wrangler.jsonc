// Cloudflare Workers Builds runs `npx wrangler deploy` after `npm run build`
// on main, and `npx wrangler preview` on other branches.
// This file makes that a plain static-assets upload of dist/: no Worker code,
// no adapter. Without it, Wrangler reconfigures the project on every deploy.
// After Coachboard's wrangler.jsonc (commit 4ceafd4).
{
  // Not "kayhardam-dev": that Worker served the placeholder on kayhardam.dev
  // and www. This one took the domain over in phase 6.
  "name": "kayhardam-site",
  // Keep this in the past: Cloudflare rejects a date newer than its runtime.
  // Nothing here depends on it; the Worker only serves files.
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /en → /en/, as trailingSlash: "always" expects.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html, with status 404, for anything that doesn't exist.
    "not_found_handling": "404-page"
  },
  // The production domain (phase 6). It lives here, not only in the dashboard:
  // a deploy whose config lacks it removes it again. Workers Builds runs
  // wrangler without a terminal, so the deploy after the merge takes the domain
  // over from Worker kayhardam-dev (the placeholder) without asking.
  // www redirects to it with a Redirect Rule in the dashboard: a Custom Domain
  // matches one exact hostname.
  "routes": [{ "pattern": "kayhardam.dev", "custom_domain": true }],
  // No workers.dev address: the site's home is its own domain. A preview URL
  // per branch; `wrangler preview` publishes no routes, so a branch never
  // touches the domain.
  "workers_dev": false,
  "preview_urls": true,
  // `wrangler preview` refuses to run without this block. It may stay empty:
  // it only holds preview-specific bindings and vars, and there are none.
  "previews": {},
  // Port 8788, not 8787: Coachboard's wrangler dev and e2e tests may run at the same time.
  "dev": { "port": 8788 }
}
